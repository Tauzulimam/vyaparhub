generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MarketplaceStatus {
  ACTIVE
  SUSPENDED
}

enum UnitType {
  G
  KG
  ML
  L
  PIECE
  PACK
  DOZEN
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CancellationReason {
  ITEM_STOCK_UNAVAILABLE
  CUSTOMER_CANCELLED
  STORE_REJECTED
  STORE_UNABLE_TO_FULFIL
  DELIVERY_ISSUE
  DUPLICATE_ACCIDENTAL_ORDER
  PAYMENT_ISSUE
  OTHER
}

enum OrderActorType {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
  DELIVERY
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// EXPIRING_SOON is intentionally not stored; it is derived from endDate.
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum GstStatus {
  REGISTERED
  NOT_REGISTERED
}

// ---------- Identity ----------

model User {
  authUserId    String        @unique @db.Uuid // Supabase auth.users.id (no Prisma relation)
  id            String        @id @default(cuid())
  email         String        @unique
  phone         String        @unique
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?

  @@index([role, accountStatus])
  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  addresses Address[]
  cart      Cart?
  orders    Order[]

  @@map("customer_profiles")
}

model VendorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  ownerName          String
  registeredMobile   String
  businessEmail      String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores Store[]

  @@index([verificationStatus])
  @@map("vendor_profiles")
}

// ---------- Catalogue / Stores ----------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  stores         Store[]
  masterProducts MasterProduct[]

  @@index([isActive])
  @@map("categories")
}

model Store {
  id                 String             @id @default(cuid())
  vendorProfileId    String
  categoryId         String
  name               String
  description        String?
  phone              String
  email              String?
  addressLine1       String
  addressLine2       String?
  area               String
  city               String
  state              String
  postalCode         String
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  openingTime        String? // "HH:mm" 24h, store-local time
  closingTime        String? // "HH:mm" 24h, store-local time
  deliveryRadiusKm   Decimal            @default(0) @db.Decimal(5, 2)
  minimumOrderAmount Decimal            @default(0) @db.Decimal(10, 2)
  isOpen             Boolean            @default(false) // vendor-controlled
  verificationStatus VerificationStatus @default(PENDING)
  marketplaceStatus  MarketplaceStatus  @default(ACTIVE) // admin-controlled
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  vendorProfile   VendorProfile         @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  category        Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  businessDetails StoreBusinessDetails?
  storeProducts   StoreProduct[]
  carts           Cart[]
  orders          Order[]
  subscription    Subscription?

  @@index([vendorProfileId])
  @@index([categoryId])
  @@index([city, area])
  @@index([postalCode])
  @@index([verificationStatus, marketplaceStatus, isOpen])
  @@map("stores")
}

model StoreBusinessDetails {
  id                String    @id @default(cuid())
  storeId           String    @unique
  gstStatus         GstStatus
  gstin             String?   @unique
  legalBusinessName String?
  gstVerified       Boolean   @default(false)
  gstVerifiedAt     DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_business_details")
}

// ---------- Product catalogue ----------

// Platform-wide product identity. Deactivate (isActive = false) instead of deleting.
model MasterProduct {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  brand       String?
  unitValue   Decimal  @db.Decimal(10, 3)
  unitType    UnitType
  mrp         Decimal  @db.Decimal(10, 2)
  imageUrl    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  storeProducts StoreProduct[]
  orderItems    OrderItem[]

  @@index([categoryId, isActive])
  @@index([name])
  @@index([brand])
  @@map("master_products")
}

// A store's listing of a master product (price + stock only).
model StoreProduct {
  id              String   @id @default(cuid())
  storeId         String
  masterProductId String
  sellingPrice    Decimal  @db.Decimal(10, 2)
  stockQuantity   Int      @default(0)
  isAvailable     Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([storeId, masterProductId])
  @@index([masterProductId])
  @@index([storeId, isAvailable])
  @@map("store_products")
}

// ---------- Customer addresses & cart ----------

model Address {
  id                String       @id @default(cuid())
  customerProfileId String
  label             AddressLabel @default(HOME)
  recipientName     String
  phone             String
  addressLine1      String
  addressLine2      String?
  landmark          String?
  area              String
  city              String
  state             String
  postalCode        String
  latitude          Decimal?     @db.Decimal(9, 6)
  longitude         Decimal?     @db.Decimal(9, 6)
  isDefault         Boolean      @default(false) // single default enforced in app logic
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([customerProfileId, isDefault])
  @@map("addresses")
}

// One active cart per customer, bound to exactly one store. Not authoritative:
// checkout revalidates store/product status, stock and current price.
model Cart {
  id                String   @id @default(cuid())
  customerProfileId String   @unique
  storeId           String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items           CartItem[]

  @@index([storeId])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  storeProductId String
  quantity       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  cart         Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  @@unique([cartId, storeProductId])
  @@index([storeProductId])
  @@map("cart_items")
}

// ---------- Orders (historical / financial records: never cascade-deleted) ----------

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique // public ID, e.g. VPH-...
  customerProfileId  String
  storeId            String
  storeNameSnapshot  String // checkout-time snapshot; Store relation is kept
  storePhoneSnapshot String?
  addressId          String? // reference only; OrderAddress is the historical snapshot
  status             OrderStatus         @default(PLACED)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus       @default(PENDING)
  subtotal           Decimal             @db.Decimal(10, 2)
  deliveryFee        Decimal             @default(0) @db.Decimal(10, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal             @db.Decimal(10, 2)
  cancellationReason CancellationReason?
  cancellationNote   String?
  cancelledByType    OrderActorType?
  cancelledById      String? // polymorphic actor id by cancelledByType; intentionally no FK
  cancelledAt        DateTime?           @db.Timestamptz(3)
  placedAt           DateTime            @default(now()) @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  customerProfile CustomerProfile      @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  address         Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  deliveryAddress OrderAddress?
  statusHistory   OrderStatusHistory[]

  @@index([customerProfileId, placedAt])
  @@index([storeId, status, placedAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([cancellationReason, cancelledByType, cancelledAt])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  masterProductId     String
  storeProductId      String
  productNameSnapshot String
  brandSnapshot       String?
  unitSnapshot        String // human-readable unit label at purchase time, e.g. "500 g"
  imageUrlSnapshot    String
  unitPrice           Decimal  @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  storeProduct  StoreProduct  @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([masterProductId])
  @@index([storeProductId])
  @@map("order_items")
}

// Immutable checkout address snapshot.
model OrderAddress {
  id            String   @id @default(cuid())
  orderId       String   @unique
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  landmark      String?
  area          String
  city          String
  state         String
  postalCode    String
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_addresses")
}

model OrderStatusHistory {
  id            String         @id @default(cuid())
  orderId       String
  status        OrderStatus
  changedByType OrderActorType
  changedById   String? // actor id (polymorphic by changedByType); intentionally no FK
  note          String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

// ---------- Subscriptions (vendor/store -> VyaparHub platform revenue; separate from Order/GMV) ----------

model Subscription {
  id           String             @id @default(cuid())
  storeId      String             @unique // one current subscription per store
  planName     String
  billingCycle BillingCycle
  amount       Decimal            @db.Decimal(10, 2)
  startDate    DateTime           @db.Timestamptz(3)
  endDate      DateTime           @db.Timestamptz(3)
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  periods  SubscriptionPeriod[]
  invoices SubscriptionInvoice[]

  @@index([status, endDate])
  @@map("subscriptions")
}

model SubscriptionPeriod {
  id             String        @id @default(cuid())
  subscriptionId String
  billingCycle   BillingCycle
  amount         Decimal       @db.Decimal(10, 2)
  startDate      DateTime      @db.Timestamptz(3)
  endDate        DateTime      @db.Timestamptz(3)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoices     SubscriptionInvoice[]

  @@unique([id, subscriptionId]) // target for composite FK from SubscriptionInvoice
  @@index([subscriptionId, startDate])
  @@index([paymentStatus])
  @@map("subscription_periods")
}

model SubscriptionInvoice {
  id                   String        @id @default(cuid())
  subscriptionId       String
  subscriptionPeriodId String
  invoiceNumber        String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  issuedAt             DateTime      @db.Timestamptz(3)
  paidAt               DateTime?     @db.Timestamptz(3)
  paymentStatus        PaymentStatus @default(PENDING)
  documentUrl          String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)

  subscription       Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  subscriptionPeriod SubscriptionPeriod @relation(fields: [subscriptionPeriodId, subscriptionId], references: [id, subscriptionId], onDelete: Restrict)

  @@index([subscriptionId, issuedAt])
  @@index([subscriptionPeriodId])
  @@index([paymentStatus, issuedAt])
  @@map("subscription_invoices")
}
